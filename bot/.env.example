# Environment: local/development/production
APP_ENV=production

# Database
# Laragon screenshot user: 127.0.0.1:3307, root, password kosong.
# cPanel umumnya: localhost:3306 dengan DB_USER/DB_PASS dari hosting.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bot_wa_v1
DB_USER=cpanel_user_db
DB_PASS=ganti_password_database
DB_CONNECTION_LIMIT=5
DB_TIMEZONE=+07:00
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Aplikasi
TZ=Asia/Jakarta
SCHEDULER_INTERVAL_MS=30000
SESSION_DIR=./sessions
